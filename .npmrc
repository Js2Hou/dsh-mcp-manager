# The @deepseek-ai/* packages are provided by the DeepSeek Harness runtime at
# load time (never fetched from npm); type-checking resolves them through the
# `paths` block in tsconfig.json. autoInstallPeers=false keeps pnpm from trying
# to fetch the experimental rc.1 packages from the registry.
autoInstallPeers=false
strict-peer-dependencies=false
